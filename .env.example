# Copy to .env (never commit .env). Everything is optional — with no keys the
# platform runs fully offline against the demo bot in mock mode.

# --- Demo bank bot (AI under test) ---
BOT_MODE=mock                    # mock | llm
BOT_URL=http://127.0.0.1:8000
# BOT_LLM_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible API (OpenRouter, Groq, Ollama…)
# BOT_LLM_API_KEY=
# BOT_LLM_MODEL=gpt-4o-mini

# --- Extra targets (appear in the dashboard once set) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# COMPAT_BASE_URL=http://localhost:11434/v1    # e.g. Ollama serving an Arabic model
# COMPAT_MODEL=
# COMPAT_LABEL=ALLaM 7B (local)
# COMPAT_API_KEY=

# --- LLM judge for rubric-scored cases (accuracy / dialect / bias) ---
# JUDGE_PROVIDER=openai:chat:gpt-4o-mini

EVAL_CONCURRENCY=4
