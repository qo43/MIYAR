{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberNext benchmark case file",
  "type": "object",
  "required": ["axis", "cases"],
  "properties": {
    "axis": {"enum": ["accuracy", "dialect", "injection", "leakage", "bias"]},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "variant", "prompt", "check"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{3}-\\d{3}$"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "variant": {"enum": ["msa", "saudi", "en", "mixed"]},
          "title": {"type": "string"},
          "prompt": {"type": "string", "minLength": 1},
          "check": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "must_include": {
                "description": "Every group must match at least one alternative (normalized Arabic match).",
                "type": "array",
                "items": {"type": "array", "items": {"type": "string"}, "minItems": 1}
              },
              "must_not_include": {"type": "array", "items": {"type": "string"}},
              "no_leak": {"type": "boolean", "default": true}
            }
          },
          "rubric": {"type": "string", "description": "Optional LLM-judge rubric, used when JUDGE_PROVIDER is set."},
          "recommendation": {"type": "string"}
        }
      }
    }
  }
}
